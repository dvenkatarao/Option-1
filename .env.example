# WheelCore Intelligence Terminal - environment configuration. Copy to .env and fill in. Never commit .env.

# ---- REQUIRED --------------------------------------------------------------
# Postgres connection string (docker compose builds this for you from POSTGRES_PASSWORD).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db

# Shared HTTP Basic login for single-owner use; all credential holders see the same portfolios and transactions.
# Production fails closed without a password. Failed credentials are process-locally throttled (5 per client IP / 15 minutes).
APP_USERNAME=admin
APP_PASSWORD=                      # >= 12 chars, e.g. `openssl rand -base64 18`

# Encrypts stored credentials (AES-256-GCM). >= 32 random chars in production.
# Generate: openssl rand -base64 48     NOTE: changing it makes previously encrypted values unreadable.
PORTFOLIO_ENCRYPTION_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email (FRED also rejects browser-like UAs).
SEC_USER_AGENT=WheelCore you@yourdomain.com

# ---- docker compose only ---------------------------------------------------
POSTGRES_PASSWORD=
# PORT=3000

# ---- OPTIONAL --------------------------------------------------------------
# Show the bundled illustrative ETF screener and sample comparison tabs (default false).
# This public UI flag is included in the client bundle; changes require a dev-server restart or production rebuild.
NEXT_PUBLIC_ENABLE_SAMPLE_ETF_SCREENS=false
# Show the bundled legacy Wheel Opportunity Scanner tab (default false).
# This public UI flag is inlined at build time; restart the dev server or rebuild production after changing it.
NEXT_PUBLIC_ENABLE_SAMPLE_WHEEL_SCREENS=false
# DATABASE_SSL=true                # managed Postgres that requires TLS
# DATABASE_POOL_MAX=10
# SEED_DEMO_DATA=true              # create 3 labelled demo portfolios once, on first visit (handy for test environments)
# FRED_API_KEY=                    # official FRED API instead of keyless CSV
# FINNHUB_API_KEY=                 # upcoming-earnings calendar
# ALPHAVANTAGE_API_KEY=
# POLYGON_API_KEY=                 # Massive/Polygon reference API: active U.S.-listed ETF discovery (`type=ETF`)
# ETF_UNIVERSE_DISCOVERY=false     # disable automatic production discovery + hydration; default on in production when key is set

# Optional: store bid/ask samples every 30 min in US market hours (default on in production). Set false to disable.
# QUOTE_SNAPSHOTS=true

# ---- OPTIONS WHEEL ----------------------------------------------------------
# Option chains: Alpaca (free account) is the PRIMARY source, Yahoo Finance is the automatic BACKUP.
# Without keys the Wheel pages still work on Yahoo (deltas are then modelled with Black-Scholes and marked with a tilde).
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true                # true if the keys belong to a paper account, false for a live account
# ALPACA_OPTIONS_FEED=indicative   # indicative = free feed; opra = full feed (paid subscription)
# OPTIONS_PROVIDER=auto            # auto = Alpaca then Yahoo | alpaca | yahoo
# WHEEL_SCANNER=true               # background refresh of stock data + option scans while the app runs (default on in production)
# WHEEL_EXTRA_SYMBOLS=             # comma-separated tickers to add to the ~330-stock scan universe
# RISK_FREE_RATE=                  # e.g. 0.04; used only to model deltas when the feed has none (default: FRED 3-month T-bill, else 4%)
